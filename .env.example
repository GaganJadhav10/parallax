# ==============================================================================
# ReconLens Production Environment Configuration Example
# Copy this file to .env (do NOT commit secrets or real production tokens)
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Server Configuration (ReconLens Go API)
# ------------------------------------------------------------------------------
# Bind host (use 0.0.0.0 when running behind a reverse proxy like Caddy/Nginx)
RECONLENS_HOST=0.0.0.0

# Listening port
RECONLENS_PORT=8080

# Persistent SQLite database storage path (must reside on a persistent volume)
RECONLENS_DB=/var/lib/reconlens/reconlens.db

# Production CORS origins (allow ONLY your exact Netlify or custom frontend domain)
# Example: https://reconlens.netlify.app or https://app.reconlens.io
RECONLENS_CORS_ORIGINS=https://reconlens.netlify.app

# Maximum concurrent active scans before returning HTTP 429 Too Many Requests
RECONLENS_MAX_CONCURRENT_SCANS=10

# ------------------------------------------------------------------------------
# Passive OSINT Provider API Keys (Optional Server-Side Credentials)
# The browser NEVER receives or interacts with these keys.
# ------------------------------------------------------------------------------
VT_API_KEY=your_virustotal_api_key_here
SHODAN_API_KEY=your_shodan_api_key_here
OTX_API_KEY=your_alienvault_otx_api_key_here

# ------------------------------------------------------------------------------
# Frontend Dashboard Configuration (React/Vite SPA on Netlify)
# Set this in your Netlify Site Settings > Environment Variables
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=https://api.reconlens.io
